{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quizzer.dev/schemas/quizzer.catalog.v1.json",
  "title": "Quizzer plugin registry catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "publishedAt",
    "signatureAlgorithm",
    "publicKeyId",
    "signature",
    "plugins"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": [
        "string",
        "integer"
      ]
    },
    "publishedAt": {
      "type": "string"
    },
    "signatureAlgorithm": {
      "const": "ed25519"
    },
    "publicKeyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "signature": {
      "type": "string",
      "minLength": 40
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "version",
          "capabilities",
          "platforms",
          "resources",
          "permissions",
          "manifestUrl",
          "downloadSize"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "extractor",
                "ocr",
                "embedder",
                "vector-index",
                "reranker",
                "generator"
              ]
            }
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "os",
                "architectures"
              ],
              "properties": {
                "os": {
                  "enum": [
                    "darwin",
                    "linux",
                    "win32"
                  ]
                },
                "architectures": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "x64",
                      "arm64"
                    ]
                  }
                }
              }
            }
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "memoryMB",
              "diskMB"
            ],
            "properties": {
              "memoryMB": {
                "type": "integer",
                "minimum": 0
              },
              "diskMB": {
                "type": "integer",
                "minimum": 0
              },
              "accelerators": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "cpu",
                    "metal",
                    "cuda",
                    "rocm"
                  ]
                }
              }
            }
          },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "network",
              "filesystem",
              "secrets",
              "subprocess"
            ],
            "properties": {
              "network": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "filesystem": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "scoped-temp",
                    "document-read",
                    "model-read",
                    "persistent-data"
                  ]
                }
              },
              "secrets": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
                }
              },
              "subprocess": {
                "type": "boolean"
              }
            }
          },
          "manifestUrl": {
            "type": "string"
          },
          "downloadBaseUrl": {
            "type": "string"
          },
          "downloadSize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 67108864
                }
              }
            }
          }
        }
      }
    }
  }
}
