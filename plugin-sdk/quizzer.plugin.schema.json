{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quizzer.dev/schemas/quizzer.plugin.v1.json",
  "title": "Quizzer plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "protocolVersion",
    "entrypoint",
    "capabilities",
    "platforms",
    "resources",
    "configuration",
    "permissions",
    "healthCheck",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "maxLength": 500 },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$" },
    "protocolVersion": { "const": 1 },
    "entrypoint": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["extractor", "ocr", "embedder", "vector-index", "reranker", "generator"]
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["os", "architectures"],
        "properties": {
          "os": { "enum": ["darwin", "linux", "win32"] },
          "architectures": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["x64", "arm64"] }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memoryMB", "diskMB"],
      "properties": {
        "memoryMB": { "type": "integer", "minimum": 0 },
        "diskMB": { "type": "integer", "minimum": 0 },
        "accelerators": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["cpu", "metal", "cuda", "rocm"] }
        }
      }
    },
    "configuration": {
      "type": "object",
      "description": "JSON Schema for non-secret plugin configuration."
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "filesystem", "secrets", "subprocess"],
      "properties": {
        "network": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "filesystem": { "type": "array", "uniqueItems": true, "items": { "enum": ["scoped-temp", "document-read", "model-read", "persistent-data"] } },
        "secrets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" } },
        "subprocess": { "type": "boolean" }
      }
    },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "timeoutMs"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "value": { "type": "string", "minLength": 40 }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "capabilities": { "contains": { "const": "vector-index" } } } },
    "then": {
      "properties": {
        "permissions": {
          "properties": {
            "filesystem": {
              "allOf": [
                { "contains": { "const": "scoped-temp" } },
                { "contains": { "const": "persistent-data" } }
              ]
            }
          }
        }
      }
    }
  }]
}
