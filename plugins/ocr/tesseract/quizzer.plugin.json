{
  "schemaVersion": 1,
  "id": "quizzer.ocr.tesseract",
  "name": "Tesseract OCR",
  "description": "Self-contained local OCR with bundled Tesseract 5.5.3 and English fast language data.",
  "version": "1.0.0",
  "protocolVersion": 1,
  "entrypoint": "plugin.mjs",
  "capabilities": ["ocr"],
  "platforms": [
    { "os": "darwin", "architectures": ["x64", "arm64"] },
    { "os": "linux", "architectures": ["x64", "arm64"] },
    { "os": "win32", "architectures": ["x64"] }
  ],
  "resources": { "memoryMB": 128, "diskMB": 192, "accelerators": ["cpu"] },
  "configuration": {
    "type": "object",
    "additionalProperties": false,
    "properties": { "language": { "type": "string", "enum": ["eng"], "default": "eng" } }
  },
  "permissions": {
    "network": [],
    "filesystem": ["scoped-temp", "document-read"],
    "secrets": [],
    "subprocess": true
  },
  "healthCheck": { "method": "plugin.health", "timeoutMs": 5000 },
  "files": [{ "path": "plugin.mjs", "sha256": "7c2e4c127d98e79ed09bc2b235e0b01026abd9197e7cde4caf274e1d402964ef" }]
}
