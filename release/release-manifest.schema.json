{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Somethings1/quizzer/releases/download/schema/release-manifest.schema.json",
  "title": "Quizzer signed release manifest",
  "type": "object",
  "additionalProperties": false,
  "$comment": "The Ed25519 signature covers UTF-8 canonical JSON with object keys sorted recursively and the signature property omitted.",
  "required": ["schemaVersion", "version", "channel", "publishedAt", "signatureAlgorithm", "publicKeyId", "signature", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "channel": { "enum": ["stable", "beta"] },
    "publishedAt": { "type": "string", "format": "date-time" },
    "signatureAlgorithm": { "const": "ed25519" },
    "publicKeyId": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 40 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "platform", "architecture", "format", "url", "size", "sha256", "minimumOs"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9_.-]{0,126}[a-zA-Z0-9])?$"
          },
          "platform": { "enum": ["windows", "macos", "linux"] },
          "architecture": { "enum": ["x64", "arm64"] },
          "format": { "enum": ["exe", "msi", "dmg", "pkg", "zip", "appimage", "deb", "rpm", "tar.gz", "sea"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "size": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "minimumOs": { "type": "string", "minLength": 1 },
          "cli": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
