{
  "name": "quizzer",
  "productName": "Quizzer",
  "description": "Local-first document-to-quiz desktop application and CLI.",
  "author": "Quizzer contributors",
  "license": "Apache-2.0",
  "private": true,
  "version": "1.0.0-beta.11",
  "type": "module",
  "main": "desktop/main.mjs",
  "bin": {
    "quizzer": "scripts/quizzer.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "tailscale": "node scripts/tailscale.mjs",
    "dev:web": "vite",
    "service": "node server.mjs",
    "cli": "node scripts/quizzer.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:cost": "playwright test --config=playwright.cost.config.ts --project=chromium",
    "test:e2e:electron": "node scripts/test-electron-shell.mjs",
    "screenshots:readme": "playwright test --config=playwright.readme.config.ts",
    "test:coverage": "node scripts/test-coverage.mjs",
    "eval:rag": "node scripts/evaluate-rag.mjs",
    "license:check": "node scripts/check-licenses.mjs",
    "preview": "vite preview",
    "package:desktop": "npm run build && node scripts/forge.mjs package",
    "make:desktop": "npm run build && node scripts/forge.mjs make",
    "verify:desktop-fuses": "node scripts/verify-electron-fuses.mjs",
    "build:cli": "node scripts/build-cli-sea.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:trust": "node scripts/verify-release-trust.mjs",
    "release:installers": "node scripts/prepare-release-installers.mjs"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.22.3",
    "apache-arrow": "^18.1.0",
    "better-sqlite3": "^12.11.1",
    "pdfjs-dist": "^5.3.31"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@codemirror/lang-json": "^6.0.2",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-pkg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^3.7.0",
    "@electron/windows-sign": "^1.2.2",
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.63.0",
    "@reforged/maker-appimage": "5.3.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^4.5.2",
    "antd": "^5.29.3",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^1.1.7",
    "electron": "^44.2.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "js-yaml": "^4.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "uuid": "^14.0.2",
    "vite": "^7.0.0"
  }
}
