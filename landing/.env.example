# Base64-encoded raw Ed25519 public key used to verify the canonical release manifest.
# This is public verification material, not a secret. Production publishing must
# set it before enabling direct artifact links.
NEXT_PUBLIC_QUIZZER_RELEASE_PUBLIC_KEY=
# Human-readable ID embedded in the signed manifest. It must identify the key
# above exactly, so a valid signature cannot be presented under another key ID.
NEXT_PUBLIC_QUIZZER_RELEASE_PUBLIC_KEY_ID=
